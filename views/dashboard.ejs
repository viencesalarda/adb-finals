<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Campus Lost &amp; Found</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        .dashboard-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .dashboard-actions .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            cursor: pointer;
        }

        #quickActions {
            position: static !important;
            top: auto !important;
            left: auto !important;
            transform: none !important;
        }

        .dashboard-stat p {
            font-size: 1.8rem;
            font-weight: bold;
        }

        .stat-split {
            display: flex;
            gap: 32px;
            margin-top: 8px;
        }

        .stat-split .stat-part span {
            display: block;
            font-size: 0.85rem;
            opacity: 0.8;
            margin-bottom: 4px;
        }

        .stat-split .stat-part p {
            margin: 0;
        }

        .stat-split .lost-num {
            color: #ef4444;
        }

        .stat-split .found-num {
            color: #22c55e;
        }

        .role-badge {
            display: inline-flex;
            align-items: center;
            padding: 6px 12px;
            border-radius: 999px;
            background: #1d4ed8;
            color: #fff;
            font-size: 0.8rem;
            font-weight: bold;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }
    </style>
</head>

<body class="dashboard-bg">

    <header class="nav">
        <a href="/" class="brand">
            <img src="/img/logo.png" alt="Campus Logo">
            <span></span>
        </a>

        <nav>

            <% if (user && (user.role === 'admin' || Number(user.is_admin) === 1)) { %>
                <span class="role-badge">ADMIN</span>
            <% } %>

            <form action="/logout" method="POST" class="inline">
                <button type="submit" class="btn danger">Logout</button>
            </form>
        </nav>
    </header>

    <main class="dashboard-container">

        <section class="dashboard-welcome">
            <h1>
                Welcome, Admin <%= user ? user.name : 'Admin' %>!
            </h1>

            <p>
                Manage Campus Lost &amp; Found reports and registered users.
            </p>
        </section>

        <section class="dashboard-stats">

            <div class="dashboard-stat">
                <h3>Total Registered Users</h3>
                <p><%= userTotal %></p>
            </div>

            <div class="dashboard-stat">
                <h3>Total Items</h3>
                <p><%= itemTotal %></p>
            </div>

            <div class="dashboard-stat found">
                <h3>Lost &amp; Found</h3>
                <div class="stat-split">
                    <div class="stat-part">
                        <span>Total Lost</span>
                        <p class="lost-num"><%= lostTotal %></p>
                    </div>
                    <div class="stat-part">
                        <span>Total Found</span>
                        <p class="found-num"><%= foundTotal %></p>
                    </div>
                </div>
            </div>

        </section>

        <section class="dashboard-section" id="quickActions">
            <h2>Quick Actions</h2>

            <div class="dashboard-actions">

                <a href="/admin/items" class="btn">
                    Reports
                </a>

                <a href="/admin/accounts" class="btn">
                    Manage Accounts
                </a>

                <a href="/" class="btn secondary">
                    Visit Homepage
                </a>

                <a href="/items/new?type=lost" class="btn found-btn">
                    Report an Item
                </a>

            </div>
        </section>

        <section class="dashboard-section">
            <h2>Admin Information</h2>

            <p>
                You are logged in to the administrator dashboard.
            </p>

            <p class="muted">
                Use Reports to view, add, edit, and delete lost and found reports.
                Use Manage Accounts to review registered users.
            </p>
        </section>

    </main>

    <footer class="footer">
    </footer>

</body>
</html>