
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Accounts</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        .accounts-page {
            width: 100%;
            margin: 35px auto;
            padding: 0 20px;
        }

        .container {
            max-width: 1600px;
            width: 100%;
            margin: 0;
            padding: 0;
        }

        .accounts-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 25px;
        }

        .accounts-heading h1 {
            margin: 0 0 6px;
            font-size: 2rem;
        }

        .accounts-heading p {
            margin: 0;
            color: var(--muted);
        }

        .heading-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .accounts-page .btn {
            text-align: center;
            font-weight: 600;
            transition: 0.2s ease;
        }

        .accounts-page .btn:hover {
            transform: translateY(-2px);
        }

        .accounts-page .btn.secondary {
            background: #475569;
            color: #ffffff;
        }

        .accounts-flash {
            padding: 12px 16px;
            margin-bottom: 20px;
            border-radius: 10px;
            border: 1px solid var(--line);
            overflow-wrap: anywhere;
        }

        .accounts-flash.success {
            background: #dcfce7;
            color: #166534;
        }

        .accounts-flash.error {
            background: #fee2e2;
            color: #991b1b;
        }

        .accounts-panel {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 5px 18px rgba(0, 0, 0, 0.05);
        }

        .accounts-panel-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
            padding: 15px;
            border-bottom: 1px solid var(--line);
        }

        .accounts-panel-heading h2 {
            margin: 0;
            font-size: 1.2rem;
        }

        .accounts-search {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin: 0;
        }

        .accounts-search input {
            width: 280px;
            max-width: 100%;
            padding: 10px 12px;
            border: 1px solid var(--line);
            border-radius: 8px;
            background: var(--bg);
            color: var(--fg);
            font: inherit;
        }

        .accounts-search input:focus {
            outline: 2px solid var(--brand);
            outline-offset: 2px;
        }

        .accounts-table-wrap {
            width: 100%;
            overflow-x: auto;
        }

        .accounts-table {
            width: 100%;
            border-collapse: collapse;
            white-space: nowrap;
        }

        .accounts-table thead {
            background: var(--bg);
        }

        .accounts-table th {
            padding: 15px 18px;
            text-align: left;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: var(--muted);
            border-bottom: 1px solid var(--line);
        }

        .accounts-table td {
            padding: 16px 18px;
            border-bottom: 1px solid var(--line);
            vertical-align: middle;
        }

        .accounts-table tbody tr {
            transition: background 0.2s ease;
        }

        .accounts-table tbody tr:hover {
            background: rgba(22, 131, 74, 0.06);
        }

        .accounts-table tbody tr:last-child td {
            border-bottom: none;
        }

        .account-id {
            color: var(--muted);
            font-weight: 600;
        }

        .account-name {
            font-weight: 700;
        }

        .account-email {
            color: var(--muted);
        }

        .account-role {
            display: inline-block;
            padding: 5px 11px;
            border-radius: 99px;
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: capitalize;
        }

        .account-role.admin {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .account-role.user {
            background: #dcfce7;
            color: #166534;
        }

        .account-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .accounts-page .btn-edit {
            background: #2563eb;
            color: #ffffff;
        }

        .accounts-page .btn-delete {
            background: #dc2626;
            color: #ffffff;
        }

        .account-actions form {
            display: inline;
            margin: 0;
        }

        .empty-accounts {
            padding: 45px 20px !important;
            text-align: center;
            color: var(--muted);
            white-space: normal;
        }

        .empty-accounts strong {
            display: block;
            margin-bottom: 6px;
            color: var(--fg);
            font-size: 1.1rem;
        }

        @media (max-width: 700px) {
            .accounts-page {
                margin: 24px auto;
                padding: 0 14px;
            }

            .accounts-heading {
                align-items: flex-start;
                flex-direction: column;
            }

            .accounts-heading h1 {
                font-size: 1.6rem;
            }

            .heading-actions {
                width: 100%;
            }

            .heading-actions .btn {
                flex: 1;
            }

            .accounts-panel-heading {
                align-items: stretch;
                flex-direction: column;
                padding: 16px;
            }

            .accounts-search {
                flex-direction: column;
            }

            .accounts-search input,
            .accounts-search .btn {
                width: 100%;
            }

            .accounts-table th,
            .accounts-table td {
                padding: 12px;
            }

            .account-actions {
                flex-wrap: wrap;
            }
        }
    </style>
</head>

<body class="dashboard-bg">

    <%- include('../partials/header', { bodyClass: 'dashboard-bg' }) %>

    <main class="accounts-page">

        <section class="accounts-heading">
            <div>
                <h1>Manage Accounts</h1>
                <p>View, search, and manage campus user accounts.</p>
            </div>

            <div class="heading-actions">
                <a href="/admin/accounts/add" class="btn">
                    + Add Account
                </a>

                <a href="/admin/dashboard" class="btn secondary">
                    Back to Dashboard
                </a>
            </div>
        </section>

        <% if (flash) { %>
            <div class="accounts-flash <%= flash.type || '' %>">
                <%= flash.text || flash.message || flash %>
            </div>
        <% } %>

        <section class="accounts-panel">

            <div class="accounts-panel-heading">
                <h2>Account List</h2>

                <form
                    action="/admin/accounts"
                    method="GET"
                    class="accounts-search"
                >
                    <input
                        type="text"
                        name="search"
                        placeholder="Search by name or email..."
                        value="<%= search || '' %>"
                        aria-label="Search accounts"
                    >

                    <button type="submit" class="btn">
                        Search
                    </button>

                    <a href="/admin/accounts" class="btn secondary">
                        Clear
                    </a>
                </form>
            </div>

            <div class="accounts-table-wrap">
                <table class="accounts-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Course</th>
                            <th>Year Level</th>
                            <th>Role</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% if (accounts && accounts.length > 0) { %>

                            <% accounts.forEach(account => { %>
                                <tr>
                                    <td class="account-id">
                                        <%= account.id %>
                                    </td>

                                    <td class="account-name">
                                        <%= account.name %>
                                    </td>

                                    <td class="account-email">
                                        <%= account.email %>
                                    </td>

                                    <td>
                                        <%= account.course || 'N/A' %>
                                    </td>

                                    <td>
                                        <%= account.year_level || 'N/A' %>
                                    </td>

                                    <td>
                                        <% const accountRole = account.role || (Number(account.is_admin) === 1 ? 'admin' : 'user'); %>

                                        <span class="account-role <%= String(accountRole).toLowerCase() === 'admin' ? 'admin' : 'user' %>">
                                            <%= accountRole %>
                                        </span>
                                    </td>

                                    <td>
                                        <div class="account-actions">
                                            <a
                                                href="/admin/accounts/edit/<%= account.id %>"
                                                class="btn btn-edit"
                                            >
                                                Edit
                                            </a>

                                            <form
                                                action="/admin/accounts/delete/<%= account.id %>"
                                                method="POST"
                                                onsubmit="return confirm('Are you sure you want to delete this account?');"
                                            >
                                                <button
                                                    type="submit"
                                                    class="btn btn-delete"
                                                >
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>

                        <% } else { %>
                            <tr>
                                <td colspan="7" class="empty-accounts">
                                    <strong>No accounts found</strong>
                                    Try another name or email, or add a new account.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

        </section>

    </main>

</body>
</html>
